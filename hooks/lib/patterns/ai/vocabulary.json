{
  "id": "vocabulary",
  "feature": "aiWriting",
  "category": { "id": "vocabulary", "label": "AI frequency words", "description": "Words that appear far more often in model output than in human writing.", "tags": ["phrase"] },
  "source": "avoid-ai-writing by Conor Bronsdon (MIT) and Ryan Yannelli's house rules",
  "presets": ["default", "ryan", "technical", "all"],
  "notes": "Tier-2 verbs and nouns report only when two or more of them share a paragraph, so a single ordinary use stays quiet. `load-bearing` before a structural noun (`wall`, `beam`, `column`, `joist`, `truss`, `member`, `footing`, `slab`, `stud`, `partition`, `masonry`, `lintel`, `pier`, `rafter`, `girder`, `capacity`), with up to one adjective in between, is building terminology and stays unflagged. `bearing down`, `bearing on`, and `bearing upon` are the literal verb and stay unflagged.",
  "patterns": [
    { "phrase": "delv(?:e|es|ed|ing)", "fix": "look at, examine" },
    { "phrase": "tapestry", "fix": "describe the actual parts" },
    { "phrase": "realm", "fix": "area, field" },
    { "phrase": "embark(?:s|ed|ing)?", "fix": "start" },
    { "phrase": "beacon", "fix": "rewrite" },
    { "phrase": "testament to", "fix": "shows, proves" },
    { "phrase": "robust", "fix": "reliable, or the measured property" },
    { "phrase": "comprehensive", "fix": "complete, full" },
    { "phrase": "cutting-edge", "fix": "latest, or name the version" },
    { "phrase": "leverag(?:e|es|ed|ing)", "fix": "use", "show": "`leverage`, `leverages`, `leveraged`, `leveraging` (verb)" },
    { "phrase": "pivotal", "fix": "important, or say what depends on it" },
    { "phrase": "meticulous(?:ly)?", "fix": "careful" },
    { "phrase": "seamless(?:ly)?", "fix": "works without X, name X" },
    { "phrase": "nestled", "fix": "is in, sits" },
    { "phrase": "vibrant", "fix": "describe what is active" },
    { "phrase": "thriving", "fix": "growing, or cite a number" },
    { "phrase": "showcas(?:es|ing)", "fix": "shows", "show": "`showcases`, `showcasing` (verb)" },
    { "phrase": "deep dive", "fix": "look at, examine" },
    { "phrase": "dive into", "fix": "look at" },
    { "phrase": "bustling", "fix": "busy" },
    { "phrase": "intricate|intricacies", "fix": "complex, or name the complexity" },
    { "phrase": "ever-evolving", "fix": "changing" },
    { "phrase": "daunting", "fix": "hard" },
    { "phrase": "holistic(?:ally)?", "fix": "complete, or list what is included" },
    { "phrase": "actionable", "fix": "practical, or drop" },
    { "phrase": "impactful", "fix": "effective, or name the effect" },
    { "phrase": "learnings", "fix": "lessons, findings" },
    { "phrase": "thought leader(?:ship)?", "fix": "expert, or name the work" },
    { "phrase": "best practices", "fix": "what works, the standard approach" },
    { "phrase": "synerg(?:y|ies)", "fix": "describe the combined effect" },
    { "phrase": "interplay", "fix": "relationship" },
    { "phrase": "symphony", "fix": "describe the coordination", "show": "`symphony` (as metaphor)" },
    { "phrase": "state-of-the-art", "fix": "name the benchmark" },
    { "phrase": "world-class|best-in-class", "fix": "cite a comparison" },
    { "phrase": "future-proof", "fix": "say what changes it survives" },
    { "phrase": "empower(?:s|ed|ing)?", "fix": "let, enable" },
    { "phrase": "crucial", "fix": "important, or say what breaks without it" },
    { "phrase": "incredibly", "fix": "cut" },
    { "phrase": "competitive edge", "fix": "name the advantage" },
    { "phrase": "vast experience", "fix": "years and scope" },
    { "phrase": "excited to announce", "fix": "state the fact" },
    { "phrase": "humbled", "fix": "cut" },
    { "regex": "\\bparadigm\\b(?! shift)", "fix": "model, approach", "show": "`paradigm`" },
    { "regex": "\\bload[- ]bearing\\b(?! (?:down|on|upon)\\b)(?! (?:\\w+ )?(?:wall|beam|column|joist|truss|member|footing|slab|stud|partition|masonry|lintel|pier|rafter|girder|capacity)s?\\b)", "fix": "essential, or say what breaks without it", "show": "`load-bearing`, `load bearing` (as metaphor)" },
    { "regex": "\\bunderscore(?:s|d)? (?:the|how|that|why)\\b", "fix": "shows", "show": "`underscores the`, `underscored how`, `underscore that`, `underscores why`" },
    { "regex": "\\b(?:the|today['’]s|current|evolving|competitive|digital|tech|business|AI) landscape\\b|\\blandscape of\\b", "fix": "field, market, or cut", "show": "`the landscape`, `today's landscape`, `current landscape`, `evolving landscape`, `competitive landscape`, `digital landscape`, `tech landscape`, `business landscape`, `AI landscape`, `landscape of`" },
    { "phrase": "harness(?:es|ed|ing)?", "fix": "use", "tier": 2 },
    { "phrase": "navigat(?:e|es|ing)", "fix": "handle, or name the work", "tier": 2 },
    { "phrase": "foster(?:s|ing)?", "fix": "build, cause", "tier": 2 },
