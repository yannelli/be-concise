    { "phrase": "reimagine(?:s|d)?", "fix": "redesign", "tier": 2 },
    { "phrase": "galvaniz(?:e|es|ed)", "fix": "prompt, spur", "tier": 2 },
    { "phrase": "augment(?:s|ed|ing)?", "fix": "add to", "tier": 2 },
    { "phrase": "cultivate(?:s|d)?", "fix": "build, grow", "tier": 2 },
    { "phrase": "illuminate(?:s)?", "fix": "shows, explains", "tier": 2 },
