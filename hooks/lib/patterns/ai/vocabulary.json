    { "phrase": "spearhead(?:s|ed|ing)?", "fix": "lead", "tier": 2 },
    { "phrase": "resonates? with", "fix": "matches, appeals to", "tier": 2 },
    { "phrase": "facilitate(?:s|d)?", "fix": "help, run", "tier": 2 },
    { "phrase": "underpin(?:s|ning)?", "fix": "supports", "tier": 2 },
    { "phrase": "nuanced", "fix": "name the difference", "tier": 2 },
    { "phrase": "multifaceted", "fix": "list the parts", "tier": 2 },
