{
  "description": "Detects verbose comments, oversized files, and padded PR/issue descriptions; denies the tool call with a reason so Claude revises before you see the bloated version.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edit.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-bash.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
