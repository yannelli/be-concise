---
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import { consoleViews, installCommands } from '../data/examples';
---
<section class="console-section frame" id="console" aria-label="Console pages">
  <div class="console-views">
    {consoleViews.map((view, index) => (
      <section class:list={['console-view', { 'is-lead': index === 0 }]} aria-labelledby={`console-${view.id}`}>
        <div class="console-view-copy"><h2 id={`console-${view.id}`} data-reveal>{view.label}</h2><p data-reveal>{view.caption}</p></div>
        <Shot view={view.id} caption="" eager={index === 0} />
      </section>
    ))}
  </div>
</section>
<section class="console-start frame page-section" aria-labelledby="console-start-heading">
  <div class="console-command" data-ui data-reveal>
    <div class="terminal-meta"><span>Node.js 24 or later</span><button class="copy-button" data-copy="console"><Icon name="copy" size={15} /><span>Copy</span></button></div>
    <pre><code>{installCommands.console}</code></pre>
  </div>
  <div class="console-notes">
    <h2 id="console-start-heading" data-reveal>Start it in your terminal.</h2>
    <p data-reveal><strong>Local by default.</strong> The console listens on 127.0.0.1 with an access token for each run. It stops when you press Ctrl+C.</p>
    <p data-reveal><strong>One console for all projects.</strong> With <code>--all</code>, it follows each project that your hooks saw. Without it, it watches one folder.</p>
    <a class="text-link" href="/docs/console/" data-reveal>Read the console guide <Icon name="arrow" size={17} /></a>
  </div>
</section>
