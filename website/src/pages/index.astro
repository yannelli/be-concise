---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Film from '../components/Film.astro';
import Icon from '../components/Icon.astro';
import HookOutput from '../components/HookOutput.astro';
import Shot from '../components/Shot.astro';
import { hookOutputs } from '../data/hook-output';
---
<MarketingLayout title="Concise: your agent, less verbose" description="An open-source plugin for Claude Code, Codex, and omp. It catches verbose comments, oversized files, and padded PRs before they land. Install it with 2 commands.">
  <section class="hero frame" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" data-hero>Your agent. Less verbose.</h1>
      <p class="hero-description" data-hero>Concise catches verbose comments, oversized files, and padded PRs<br class="desktop-break" /> before your coding agent writes them.</p>
      <div class="hero-actions" data-hero><a class="button" href="/install/">Install Concise <Icon name="arrow" size={18} /></a><a class="text-link" href="/why-concise/">See how it works <Icon name="arrow" size={18} /></a></div>
      <p class="hero-note" data-hero>Open source. MIT licensed.</p>
    </div>
    <Film />
  </section>
  <section class="home-next frame" aria-labelledby="next-heading">
    <div class="home-next-copy">
      <h2 id="next-heading" data-reveal>Start with your agent.</h2>
      <p data-reveal>For Claude Code, Codex, and omp. <br />Local hooks. No extra service.</p>
      <p data-reveal>Concise answers the tool call before the write runs. The local console records each answer.</p>
      <div class="next-links" data-reveal><a class="text-link" href="/install/">Choose your install <Icon name="arrow" size={18} /></a><a class="text-link" href="/use-cases/">Find your use case <Icon name="arrow" size={18} /></a><a class="text-link" href="/docs/">Read the docs <Icon name="arrow" size={18} /></a></div>
    </div>
    <div class="home-proof-grid">
      <Shot view="activity" />
      <HookOutput output={hookOutputs.comment} />
      <HookOutput output={hookOutputs.pr} />
    </div>
  </section>
</MarketingLayout>
