---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Film from '../components/Film.astro';
import Icon from '../components/Icon.astro';
---
<MarketingLayout title="Concise — Your agent. Less verbose." description="An open-source Claude Code, Codex, and omp plugin that catches verbose comments, oversized files, and padded PRs before they land. Install in two commands.">
  <section class="hero frame" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" data-hero>Your agent. Less verbose.</h1>
      <p class="hero-description" data-hero>Concise catches verbose comments, oversized files, and padded PRs<br class="desktop-break" /> before your coding agent writes them.</p>
      <div class="hero-actions" data-hero><a class="button" href="/install/">Install Concise <Icon name="arrow" size={18} /></a><a class="text-link" href="/why-concise/">See how it works <Icon name="arrow" size={18} /></a></div>
      <p class="hero-note" data-hero>Open source. MIT licensed.</p>
    </div>
    <Film />
  </section>
  <section class="home-next frame" aria-labelledby="next-heading">
    <div><h2 id="next-heading">Start with your agent.</h2><p>For Claude Code, Codex, and omp.<br />Local hooks. No extra service.</p></div>
    <div class="next-links"><a class="text-link" href="/install/">Choose your install <Icon name="arrow" size={18} /></a><a class="text-link" href="/use-cases/">Find your use case <Icon name="arrow" size={18} /></a><a class="text-link" href="/docs/">Read the docs <Icon name="arrow" size={18} /></a></div>
  </section>
</MarketingLayout>
