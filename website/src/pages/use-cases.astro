---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Icon from '../components/Icon.astro';
import HookOutput from '../components/HookOutput.astro';
import Shot from '../components/Shot.astro';
import { hookOutputs } from '../data/hook-output';
const presetNote = 'The technical preset lets “robust” through. The other 3 phrases get a finding.'; // taste-skill-ignore: names a word the hook allows
---
<MarketingLayout title="Use cases: Concise" description="Keep reviews focused, opt into writing checks, share team rules, and configure Concise for cloud agents.">
  <header class="page-intro frame">
    <h1 data-hero>For reviews, docs, and teams.</h1>
    <p data-hero>Keep the useful detail. Skip the running commentary of the agent.</p>
  </header>
  <div class="frame proof-rows">
    <section class="proof-row" aria-labelledby="review-heading">
      <div class="proof-copy"><h2 id="review-heading" data-reveal>Review the change.</h2><p data-reveal>Keep comments short and PR bodies in a structure, so that a reviewer finds what changed.</p><a class="text-link" href="/why-concise/" data-reveal>See the core checks <Icon name="arrow" size={16} /></a></div>
      <HookOutput output={hookOutputs.pr} />
    </section>
    <section class="proof-row" aria-labelledby="docs-heading">
      <div class="proof-copy"><h2 id="docs-heading" data-reveal>Write docs in your voice.</h2><p data-reveal>Turn on the writing checks for stock phrases, unnecessary qualifiers, and canned conclusions. Start with the technical preset.</p><a class="text-link" href="/configuration/" data-reveal>Choose a writing preset <Icon name="arrow" size={16} /></a></div>
      <HookOutput output={hookOutputs.docs} caption={presetNote} />
    </section>
    <section class="proof-row" aria-labelledby="rules-heading">
      <div class="proof-copy"><h2 id="rules-heading" data-reveal>Share your house rules.</h2><p data-reveal>Commit the project configuration. Add custom pattern packs for the words that your team does not want.</p><a class="text-link" href="/docs/packs/" data-reveal>Create a custom pack <Icon name="arrow" size={16} /></a></div>
      <Shot view="rules" />
    </section>
    <section class="proof-row" aria-labelledby="cloud-heading">
      <div class="proof-copy"><h2 id="cloud-heading" data-reveal>Set up cloud agents.</h2><p data-reveal>A cloud agent often starts from a fresh checkout with no configuration file. Set the configuration in environment variables. Soft fail flags findings and does not block.</p><a class="text-link" href="/docs/environment/" data-reveal>Read the cloud recipes <Icon name="arrow" size={16} /></a></div>
      <HookOutput output={hookOutputs.cloud} />
    </section>
  </div>
  <nav class="page-next frame" aria-label="Next steps"><a class="text-link" href="/console/">Watch checks in the web console <Icon name="arrow" size={17} /></a><a class="button" href="/install/">Install Concise <Icon name="arrow" size={18} /></a></nav>
</MarketingLayout>
