---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
---
<SiteLayout title="Page not found — Concise" isDocs>
  <div class="not-found frame"><h1>This page is missing.</h1><p>The page may have moved.</p><div><a class="button button-dark" href="/">Go to homepage <Icon name="arrow" size={18} /></a><a class="text-link" href="/docs/">Open the docs</a></div></div>
</SiteLayout>
<style>.not-found{padding-block:100px 130px}.not-found h1{font-size:clamp(44px,6vw,76px);max-width:850px}.not-found p{font-size:20px;margin:30px 0}.not-found>div{display:flex;gap:30px;align-items:center;flex-wrap:wrap}</style>
