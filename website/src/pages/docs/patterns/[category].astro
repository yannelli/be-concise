---
import type { GetStaticPaths } from 'astro';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { categories, type PatternCategory } from '../../../lib/patterns';
import { renderMarkdown } from '../../../lib/render';

interface Props { category: PatternCategory; index: number; }
export const getStaticPaths = (() => categories.map((category, index) => ({ params: { category: category.id }, props: { category, index } }))) satisfies GetStaticPaths;

const { category, index } = Astro.props;
const { html } = await renderMarkdown(category.body, category.file);
const link = (item?: PatternCategory) => item && { title: item.title, href: `/docs/patterns/${item.id}/` };
---
<DocsLayout
  title={`${category.title} patterns`}
  description={`${category.description || `The ${category.label} category`} The flagged text and the fix Concise prints for the ${category.id} category.`}
  headings={[]}
  sourcePath={category.file}
  previous={link(categories[index - 1]) ?? { title: 'All categories', href: '/docs/patterns/' }}
  next={link(categories[index + 1])}
>
  <p class="pattern-back" data-pagefind-ignore><a href="/docs/patterns/">All {categories.length} categories</a></p>
  <h1>{category.title}</h1>
  {category.description && <p class="pattern-lead">{category.description}</p>}
  <dl class="pattern-meta">
    <div><dt>Category</dt><dd><code>{category.id}</code></dd></div>
    <div><dt>Group</dt><dd><a href={`/docs/patterns/#${category.group.toLowerCase().replace(/ /g, '-')}`}>{category.group}</a></dd></div>
    <div><dt>Presets</dt><dd>{category.presets.join(', ')}</dd></div>
    {category.scopes.length > 0 && <div><dt>Scopes</dt><dd>{category.scopes.join(', ')}</dd></div>}
  </dl>
  <div class="pattern-table"><Fragment set:html={html} /></div>
  {category.source && <p class="pattern-source">Source: <Fragment set:html={category.source.replace(/`([^`]+)`/g, '<code>$1</code>')} /></p>}
</DocsLayout>
