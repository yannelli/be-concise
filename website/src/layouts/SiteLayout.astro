---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
interface Props { title: string; description?: string; isDocs?: boolean; }
const { title, description = 'Keep the code. Cut the noise. Concise catches agent verbosity before it lands in Claude Code, Codex, and omp.', isDocs = false } = Astro.props;
const github = 'https://github.com/yannelli/be-concise';
const navigation = [
  ['/why-concise/', 'Why Concise'],
  ['/use-cases/', 'Use cases'],
  ['/docs/', 'Docs'],
];
const current = (href: string) => Astro.url.pathname === href || (href === '/docs/' && isDocs);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/jost-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class:list={[{ 'docs-page': isDocs }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header frame">
      <a class="wordmark" href="/" aria-label="Concise home"><Mark size={35} /><span>concise</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {navigation.map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="github-link" href={github} aria-label="Concise on GitHub"><Icon name="github" size={21} /></a>
        <a class="button button-small button-dark" href="/install/" aria-current={current('/install/') ? 'page' : undefined}>Install Concise <Icon name="arrow" size={17} /></a>
        <details class="mobile-menu">
          <summary class="menu-toggle" aria-label="Navigation"><Icon name="menu" /></summary>
          <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
            {navigation.map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
            <a href={github}>GitHub</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer compact">
      <div class="frame footer-top">
        <a class="wordmark" href="/" aria-label="Concise home"><Mark size={35} /><span>concise</span></a>
        <p>For Claude Code,<br />Codex, and omp.</p>
        <nav aria-label="Footer navigation">
          {[...navigation, ['/install/', 'Installation'], ['/configuration/', 'Configuration'], ['/console/', 'Web console'], ['/faq/', 'FAQ']].map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
          <a href={github}>Source on GitHub</a><a href={`${github}/issues`}>Report an issue</a>
        </nav>
      </div>
      <div class="frame footer-bottom"><p>Made by <a href="https://ryanyannelli.com">Ryan Yannelli</a></p><p><a href={`${github}/blob/main/LICENSE`}>MIT licensed</a><span class="footer-separator">/</span><a href="/fonts/OFL-Jost.txt">Typeface license</a></p><a href="#main">Back to top <Icon name="arrow" size={16} /></a></div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      const toggle = menu?.querySelector<HTMLElement>('summary');
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menu?.open) { menu.open = false; toggle?.focus(); }
      });
      window.matchMedia('(min-width: 651px)').addEventListener('change', event => {
        if (event.matches && menu) menu.open = false;
      });
    </script>
  </body>
</html>
