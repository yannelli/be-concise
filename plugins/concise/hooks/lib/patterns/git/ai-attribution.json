{
  "id": "ai-attribution",
  "feature": "aiWriting",
  "category": { "id": "ai-attribution", "label": "AI attribution trailer", "description": "A commit or PR trailer credits an AI tool as co-author, generator, or signer.", "tags": ["git"] },
  "source": "Group G research: claude-code#1296, Codex CLI commit attribution, VS Code #314311, Cursor forum #168258, docs.devin.ai",
  "presets": ["default", "ryan", "technical", "minimal", "git", "all"],
  "scope": ["commit", "gh", "command"],
  "notes": "The two `Co-authored-by` patterns sit at tier 2. A trailer that pairs an AI tool name with an AI email reports; a co-author named Claude with a personal address stays quiet.",
  "patterns": [
    { "regex": "^Co-authored-by:\\s*(?:Claude|Codex|Copilot|Cursor(?: Agent)?|Gemini(?:-code-assist\\[bot\\])?|Devin|OpenHands|Aider|github-actions\\[bot\\]|devin-ai-integration\\[bot\\])\\b.*$", "flags": "gim", "fix": "drop the co-author trailer", "tier": 2, "show": "`Co-authored-by:` plus an AI tool name" },
    { "regex": "^Co-authored-by:.*(?:noreply@anthropic\\.com|noreply@openai\\.com|codex@openai\\.com|copilot@github\\.com|cursoragent@cursor\\.com|openhands@all-hands\\.dev|all-hands\\.dev)>?\\s*$", "flags": "gim", "fix": "drop the co-author trailer", "tier": 2, "show": "`Co-authored-by:` plus an AI tool email" },
    { "regex": "Generated with \\[Claude Code\\]", "fix": "drop the generated-with line", "show": "`Generated with [Claude Code]`" },
    { "phrase": "Generated with Devin", "fix": "drop the generated-with line" },
    { "phrase": "Made with Cursor", "fix": "drop the made-with line" },
    { "regex": "^Generated-By:.*$", "flags": "gim", "fix": "drop the trailer", "show": "a `Generated-By:` trailer" },
    { "phrase": "This commit was generated by", "fix": "drop the disclosure sentence" },
    { "regex": "^Assisted-by:.*$", "flags": "gim", "fix": "drop the trailer", "show": "an `Assisted-by:` trailer" },
    { "regex": "^Signed-off-by:.*\\[bot\\].*$", "flags": "gim", "fix": "drop the bot sign-off", "show": "`Signed-off-by:` plus a `[bot]` account" },
    { "regex": "^Signed-off-by:.*(?:noreply@anthropic\\.com|noreply@openai\\.com|all-hands\\.dev|cursor\\.com)>?\\s*$", "flags": "gim", "fix": "drop the bot sign-off", "show": "`Signed-off-by:` plus an AI tool email" }
  ]
}
