{
  "id": "ste",
  "feature": "aiWriting",
  "category": { "id": "ste", "label": "simplified technical english", "description": "Word choices from Simplified Technical English.", "tags": ["ste"] },
  "source": "the ASD-STE100 word list",
  "presets": ["ste", "all"],
  "notes": "Off unless the preset is `ste` or `all`. The rules behind the list are in `simplified-technical-english.md`.",
  "patterns": [
    { "phrase": "accomplish(?:es|ed)?|perform(?:s|ed)?|conduct (?:a|the) (?:test|check|review)", "fix": "do", "show": "`accomplish`, `perform`, `conduct a test`, `conduct the check`, `conduct a review`" },
    { "phrase": "acquire|obtain|procure", "fix": "get" },
    { "phrase": "adhere to|comply with", "fix": "obey" },
    { "phrase": "assist|aid|assistance", "fix": "help" },
    { "phrase": "attempt(?:s|ed)?", "fix": "try" },
    { "phrase": "cease|discontinue", "fix": "stop" },
    { "phrase": "initiate(?:s|d)?|commencement", "fix": "start" },
    { "phrase": "depress (?:the|a) (?:button|switch)", "fix": "push" },
    { "phrase": "desire(?:s|d)?", "fix": "want" },
    { "phrase": "indicate(?:s|d)?", "fix": "show" },
    { "phrase": "locate(?:s|d)?", "fix": "find" },
    { "phrase": "modif(?:y|ies|ied)", "fix": "change" },
    { "phrase": "observe(?:s|d)?", "fix": "look at, see" },
    { "phrase": "permit(?:s|ted)?", "fix": "let" },
    { "phrase": "purchase(?:s|d)?", "fix": "buy" },
    { "phrase": "rectif(?:y|ies|ied)|remed(?:y|ies|ied)", "fix": "correct, repair" },
    { "phrase": "replenish(?:es|ed)?", "fix": "fill" },
    { "phrase": "retain(?:s|ed)?", "fix": "keep" },
    { "phrase": "transmit(?:s|ted)?", "fix": "send" },
    { "phrase": "verif(?:y|ies|ied)", "fix": "make sure" },
    { "phrase": "aperture", "fix": "hole" },
    { "phrase": "malfunction", "fix": "fault" },
    { "phrase": "personnel", "fix": "persons" },
    { "phrase": "portion", "fix": "part" },
    { "phrase": "remainder", "fix": "the other part" },
    { "phrase": "requirements?", "fix": "need" },
    { "phrase": "termination", "fix": "end" },
    { "phrase": "utilization", "fix": "use" },
    { "phrase": "adequate|sufficient", "fix": "enough" },
    { "phrase": "adjacent", "fix": "near, next to" },
    { "phrase": "approximately", "fix": "about" },
    { "phrase": "additional", "fix": "more" },
    { "phrase": "initial", "fix": "first" },
    { "phrase": "numerous|multiple", "fix": "many" },
    { "phrase": "optimum", "fix": "best" },
    { "phrase": "previous", "fix": "before, earlier" },
    { "phrase": "principal", "fix": "main" },
    { "regex": "(?<!designed to )\\bensure\\b", "fix": "make sure", "show": "`ensure`" },
    { "regex": "(?<!let['’]s )\\b(?:examine|inspect)\\b", "fix": "do a check of", "show": "`examine`, `inspect`" },
    { "regex": "(?<!in the )\\bvicinity\\b", "fix": "area", "show": "`vicinity`" },
    { "regex": "\\brapidly\\b(?! (?:evolving|changing))", "fix": "quickly", "show": "`rapidly`" },
    { "regex": "\\bsubsequent\\b(?! to)", "fix": "after, next", "show": "`subsequent`" }
  ]
}
