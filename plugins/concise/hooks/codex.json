{
    "description": "Detects verbose comments, oversized files, padded PR/issue descriptions, and (when enabled) em dashes and AI writing patterns in prose, comments, commit messages, and replies; denies the tool call, or blocks the reply on Stop, with a reason so the agent revises before the text lands. Works in Claude Code and Codex.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|apply_patch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edit.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: checking written text"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/monitor-filter.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: preparing test output filter"
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-bash.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: checking commit and PR text"
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edit.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: checking written text"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-reply.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: checking reply"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: loading rules"
                    }
                ],
                "matcher": "startup|resume|clear|compact"
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: loading rules"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: loading rules"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-reply.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: checking subagent reply"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs\"",
                        "timeout": 1,
                        "statusMessage": "concise: clearing session state"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-test-filter.mjs\"",
                        "timeout": 15,
                        "statusMessage": "concise: filtering test output"
                    }
                ]
            }
        ]
    }
}
