{
    "description": "Detects verbose comments, oversized files, padded PR/issue descriptions, and (when enabled) em dashes and AI writing patterns in prose, comments, commit messages, and replies; denies the tool call, or blocks the reply on Stop, with a reason so the agent revises before the text lands. Works in Claude Code and Codex.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|apply_patch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edit.mjs\"",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/monitor-filter.mjs\"",
                        "timeout": 15
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-bash.mjs\"",
                        "timeout": 15
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edit.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-reply.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"",
                        "timeout": 15
                    }
                ],
                "matcher": "startup|resume|clear|compact"
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-reply.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs\"",
                        "timeout": 1
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-test-filter.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
