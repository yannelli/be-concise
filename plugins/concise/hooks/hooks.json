{
    "description": "Detects verbose comments, oversized files, and padded PR/issue descriptions; denies the tool call with a reason so Claude revises before the write lands.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edit.mjs\"",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/PreToolUse-test-filter.sh\"",
                        "timeout": 15
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-bash.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
